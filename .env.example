# Planning inventory only. The current repository has no application reading these values.
# Keep real credentials in a secret manager; never commit a filled .env file.
# Remove or rename entries as the implementation and backend decision settle.

# Frontend/public configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side API integration (do not expose secrets through NEXT_PUBLIC_ variables)
API_BASE_URL=http://localhost:8080
SESSION_SECRET=replace-with-a-long-random-local-secret

# Candidate persistence integrations (not wired yet)
DATABASE_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
