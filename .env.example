# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
VVD_API_URL=http://127.0.0.1:4100

# Rust API
DATABASE_URL=postgres://vvd:vvd@localhost:5432/vvd_dev
APP_ENV=development
BIND_ADDRESS=127.0.0.1:4100
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Private Gallery storage (leave bucket and region empty to disable uploads).
# The AWS SDK uses its standard credential chain (environment credentials or workload identity).
VVD_S3_BUCKET=
VVD_S3_REGION=
# Optional S3-compatible endpoint, e.g. a local development object store.
VVD_S3_ENDPOINT=
VVD_S3_FORCE_PATH_STYLE=false
